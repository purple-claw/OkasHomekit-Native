[Unit]
Description=OKAS KNX Bridge (Python / xknx)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
ExecStart=/usr/bin/python3 /home/OhKnx/KNX/knx_bridge.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
User=root
Type=simple
WorkingDirectory=/home/OhKnx

[Install]
WantedBy=multi-user.target
